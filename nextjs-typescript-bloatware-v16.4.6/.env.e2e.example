# Copy to .env.e2e (git-ignored) to set local E2E options.
# Never put production credentials here.

# Test an app that is already running instead of starting the dev server.
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Also run Firefox and WebKit.
# E2E_ALL_BROWSERS=1

# Dedicated test account for tests/e2e/auth (skipped while these are empty).
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
